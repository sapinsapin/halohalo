# The one Nebius VM the research track runs on. No secrets here: this file is
# committed. Override any value per call, e.g. VM_DISK_GIB=250 bash up.sh
NEBIUS_PROJECT=${NEBIUS_PROJECT:-project-e05r4ncrln00pwmcgrdz6w}   # uk-south2
VM_NAME=${VM_NAME:-halohalo-rtx6000}
VM_PLATFORM=${VM_PLATFORM:-gpu-rtx6000-a}       # RTX PRO 6000 Blackwell, 96 GB
VM_PRESET=${VM_PRESET:-1gpu-24vcpu-218gb}
VM_PREEMPTIBLE=${VM_PREEMPTIBLE:-1}             # 0 = on-demand
VM_DISK_GIB=${VM_DISK_GIB:-500}
VM_IMAGE_FAMILY=${VM_IMAGE_FAMILY:-ubuntu24.04-cuda13.0}
VM_USER=${VM_USER:-tim}
SSH_KEY=${SSH_KEY:-$HOME/.ssh/ts_carrot}
